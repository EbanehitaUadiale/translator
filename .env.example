# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Claude API key from https://console.anthropic.com/settings/keys
# If you've run `ant auth login`, you can leave this blank and the SDK will use
# that profile instead.
ANTHROPIC_API_KEY=

# Shared password gating the whole app. Leave blank locally to skip the gate.
# REQUIRED on any public deployment: without it, anyone who finds the URL can
# translate, and every translation is billed to the API key above.
APP_PASSWORD=

# Core Django settings. SECRET_KEY is required once DEBUG is off.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres connection string. Unset falls back to local SQLite.
DATABASE_URL=
